# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local overrides — env/*.tfvars are committed (names only, no secrets)
*.tfvars
!*.tfvars.example
!env/*.tfvars

# Local env / secrets — do not commit real secrets
.env
.env.*
*.pem

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sw?
